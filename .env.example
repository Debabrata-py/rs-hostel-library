# PostgreSQL connection used by the running application
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/rs_hostel_library"

# Optional: separate connection used by Prisma migration commands.
# If omitted, Prisma uses DATABASE_URL.
# MIGRATION_DATABASE_URL="postgresql://MIGRATION_USER:PASSWORD@HOST:5432/rs_hostel_library"

# Application's public base URL.
# Development:
APP_URL="http://localhost:3000"

# Production must use the actual HTTPS address.
# Example: APP_URL="https://library.example.org"
